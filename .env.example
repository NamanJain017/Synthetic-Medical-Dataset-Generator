# =============================================================================
# Environment Variables — Synthetic Medical Imaging Generator
# =============================================================================
# Copy this file to .env and fill in your values

# GPU Configuration
CUDA_VISIBLE_DEVICES=0

# HuggingFace (for downloading SD 2.1, BioViL-T, etc.)
HF_TOKEN=your_huggingface_token_here

# Experiment Tracking (choose one)
MLFLOW_TRACKING_URI=./mlruns
# WANDB_API_KEY=your_wandb_key_here
# WANDB_PROJECT=synthetic-med-imaging

# Watermarking
WATERMARK_KEY=your_secret_watermark_key_here

# Paths
DATA_DIR=./data/raw
OUTPUT_DIR=./outputs
ADAPTER_DIR=./adapters
CONFIG_DIR=./configs

# Logging
LOG_LEVEL=INFO
